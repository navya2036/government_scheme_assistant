# ==============================================================================
# Scheme Voice Assistant - Root .gitignore
# ==============================================================================

# Environment variables & secrets (CRITICAL: NEVER commit API keys or credentials)
.env
.env.local
.env.*.local
*.env
!.env.example
!frontend/.env.example

# Python virtual environment
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python byte code and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node.js dependencies & logs
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend build outputs
frontend/dist/
dist/
build/

# Dataset
gov_myscheme/text_data/
data/extracted_text/
data/*.csv

# Generated RAG artifacts
data/*.npy
data/*.faiss
data/*.sqlite
data/chunks.jsonl
data/embeddings_metadata.jsonl