# Required LLM configuration for generation.py and api.py.
#
# There are NO defaults: the generation layer is provider- and model-agnostic.
# Supply any OpenAI-compatible chat-completions endpoint. Export these in your
# shell before starting the API (this project does not auto-load .env files):
#
#   LLM_API_KEY=... LLM_BASE_URL=... LLM_MODEL=... uvicorn api:app --port 8000
#
# Never commit real values. Vite only reads VITE_* variables, so none of these
# are ever shipped to the React bundle.

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
